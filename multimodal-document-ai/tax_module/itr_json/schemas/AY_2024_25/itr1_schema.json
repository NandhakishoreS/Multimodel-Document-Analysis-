{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ITR-1 SAHAJ Official JSON Schema (AY 2024-25)",
  "type": "object",
  "required": ["ITR"],
  "properties": {
    "ITR": {
      "type": "object",
      "required": ["ITR1"],
      "properties": {
        "ITR1": {
          "type": "object",
          "required": [
            "CreationInfo",
            "Form_ITR1",
            "PersonalInfo",
            "FilingStatus",
            "IncomeDeductions",
            "TaxComputation",
            "TaxPaid",
            "BankAccountDtls",
            "Verification"
          ],
          "properties": {
            "CreationInfo": {
              "type": "object",
              "required": ["SWCreatedBy", "JSONCreatedBy", "JSONCreationDate"],
              "properties": {
                "SWCreatedBy": { "type": "string" },
                "JSONCreatedBy": { "type": "string" },
                "JSONCreationDate": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
                "IntermediaryCity": { "type": "string" },
                "Digest": { "type": "string" }
              }
            },
            "Form_ITR1": {
              "type": "object",
              "required": ["FormName", "Description", "AssessmentYear", "SchemaVer"],
              "properties": {
                "FormName": { "type": "string", "enum": ["ITR-1"] },
                "Description": { "type": "string" },
                "AssessmentYear": { "type": "string", "enum": ["2024", "2025"] },
                "SchemaVer": { "type": "string" },
                "FormVer": { "type": "string" }
              }
            },
            "PersonalInfo": {
              "type": "object",
              "required": ["AssesseeName", "PAN", "DOB", "Status", "Address"],
              "properties": {
                "AssesseeName": {
                  "type": "object",
                  "required": ["FirstName", "SurNameOrOrgName"],
                  "properties": {
                    "FirstName": { "type": "string", "minLength": 1 },
                    "MiddleName": { "type": "string" },
                    "SurNameOrOrgName": { "type": "string", "minLength": 1 }
                  }
                },
                "PAN": {
                  "type": "string",
                  "pattern": "^[A-Z]{5}[0-9]{4}[A-Z]{1}$"
                },
                "DOB": {
                  "type": "string",
                  "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                },
                "Status": {
                  "type": "string",
                  "enum": ["I"]
                },
                "Address": {
                  "type": "object",
                  "required": ["CityTownDistrict", "StateCode", "PinCode", "CountryCode"],
                  "properties": {
                    "FlatDoorBlock": { "type": "string" },
                    "PremisesBuilding": { "type": "string" },
                    "RoadStreet": { "type": "string" },
                    "AreaLocality": { "type": "string" },
                    "CityTownDistrict": { "type": "string", "minLength": 1 },
                    "StateCode": { "type": "string" },
                    "PinCode": { "type": "integer", "minimum": 100000, "maximum": 999999 },
                    "CountryCode": { "type": "string", "default": "91" }
                  }
                },
                "EmployerCategory": {
                  "type": "string",
                  "enum": ["OTH", "GOV", "PSU", "NA"]
                }
              }
            },
            "FilingStatus": {
              "type": "object",
              "required": ["ReturnFileSec", "NewTaxRegime", "ResidentialStatus"],
              "properties": {
                "ReturnFileSec": { "type": "integer", "enum": [11, 12, 17] },
                "NewTaxRegime": { "type": "string", "enum": ["Y", "N"] },
                "ResidentialStatus": { "type": "string", "enum": ["RES"] }
              }
            },
            "IncomeDeductions": {
              "type": "object",
              "required": [
                "GrossSalary",
                "IncomeFromSal",
                "GrossTotIncome",
                "TotalIncome"
              ],
              "properties": {
                "GrossSalary": { "type": "integer", "minimum": 0 },
                "Salary": { "type": "integer", "minimum": 0 },
                "DeductionUs16": {
                  "type": "object",
                  "properties": {
                    "StandardDeductionUs16ia": { "type": "integer", "minimum": 0 },
                    "ProfessionalTaxUs16iii": { "type": "integer", "minimum": 0 }
                  }
                },
                "IncomeFromSal": { "type": "integer", "minimum": 0 },
                "TypeOfHP": { "type": "string", "enum": ["S", "L"] },
                "IncomeFromHP": { "type": "integer" },
                "IncomeOthSrc": { "type": "integer", "minimum": 0 },
                "GrossTotIncome": { "type": "integer", "minimum": 0 },
                "UsrDeductUndChapVIA": {
                  "type": "object",
                  "properties": {
                    "Section80C": { "type": "integer", "minimum": 0 },
                    "Section80D": { "type": "integer", "minimum": 0 },
                    "Section80TTA": { "type": "integer", "minimum": 0 },
                    "TotalChapVIADeductions": { "type": "integer", "minimum": 0 }
                  }
                },
                "TotalIncome": { "type": "integer", "minimum": 0 }
              }
            },
            "TaxComputation": {
              "type": "object",
              "required": [
                "TotalTaxPayable",
                "Rebate87A",
                "TaxPayableOnRebate",
                "EducationCess",
                "GrossTaxLiability",
                "NetTaxLiability"
              ],
              "properties": {
                "TotalTaxPayable": { "type": "integer", "minimum": 0 },
                "Rebate87A": { "type": "integer", "minimum": 0 },
                "TaxPayableOnRebate": { "type": "integer", "minimum": 0 },
                "EducationCess": { "type": "integer", "minimum": 0 },
                "GrossTaxLiability": { "type": "integer", "minimum": 0 },
                "NetTaxLiability": { "type": "integer", "minimum": 0 }
              }
            },
            "TaxPaid": {
              "type": "object",
              "required": ["TaxesPaid", "BalTaxPayable", "RefundDue"],
              "properties": {
                "TaxesPaid": {
                  "type": "object",
                  "required": ["TDS", "TotalTaxesPaid"],
                  "properties": {
                    "AdvanceTax": { "type": "integer", "minimum": 0 },
                    "TDS": { "type": "integer", "minimum": 0 },
                    "SelfAssessmentTax": { "type": "integer", "minimum": 0 },
                    "TotalTaxesPaid": { "type": "integer", "minimum": 0 }
                  }
                },
                "BalTaxPayable": { "type": "integer", "minimum": 0 },
                "RefundDue": { "type": "integer", "minimum": 0 }
              }
            },
            "ScheduleTDS1": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["TAN", "EmployerOrDeductorName", "IncChrgSal", "TotalTDSSal"],
                "properties": {
                  "TAN": { "type": "string", "pattern": "^[A-Z]{4}[0-9]{5}[A-Z]{1}$" },
                  "EmployerOrDeductorName": { "type": "string", "minLength": 1 },
                  "IncChrgSal": { "type": "integer", "minimum": 0 },
                  "TotalTDSSal": { "type": "integer", "minimum": 0 }
                }
              }
            },
            "BankAccountDtls": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": ["IFSC", "BankName", "BankAccountNo", "AccountType", "RefundFlag"],
                "properties": {
                  "IFSC": { "type": "string", "pattern": "^[A-Z]{4}0[A-Z0-9]{6}$" },
                  "BankName": { "type": "string", "minLength": 1 },
                  "BankAccountNo": { "type": "string", "minLength": 9 },
                  "AccountType": { "type": "string", "enum": ["SAVINGS", "CURRENT"] },
                  "RefundFlag": { "type": "string", "enum": ["Y", "N"] }
                }
              }
            },
            "Verification": {
              "type": "object",
              "required": ["Declaration"],
              "properties": {
                "Declaration": {
                  "type": "object",
                  "required": ["AssesseeVerName", "Capacity", "Place", "Date"],
                  "properties": {
                    "AssesseeVerName": { "type": "string", "minLength": 1 },
                    "FatherName": { "type": "string" },
                    "Capacity": { "type": "string", "enum": ["S"] },
                    "Place": { "type": "string", "minLength": 1 },
                    "Date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
